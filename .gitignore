# ==============================================================================
# Windows 11 Ultra Gaming Mode (v3.0) — Master Git Ignore Configuration
# ==============================================================================

# ── Compiled Binaries & Release Packages (Upload to GitHub Releases) ──────────
# Executable files and installers (belong in GitHub Releases, NOT repository)
*.exe
*.msi
*.msix
*.appx
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage

# Compiled libraries, symbols and objects
*.dll
*.sys
*.pdb
*.lib
*.exp
*.obj
*.o
*.a
*.so
*.dylib
*.bin
!/.bin/
*.iso
*.img

# Release archives and distribution bundles
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.tar.bz2

# Build bundle outputs & installer toolchains
**/bundle/
**/wix/
**/nsis/
*.wixobj
*.wixpdb
*.wixbin
releases/
release/
.bin/*
!.bin/.gitkeep
bin/*
!bin/.gitkeep

# ── Rust & Tauri Build System ─────────────────────────────────────────────────
# Cargo build tree (all profiles: debug, release)
**/target/
**/*.rs.bk

# Tauri generated schema cache
**/src-tauri/gen/

# ── Node.js, Frontend & Vite ──────────────────────────────────────────────────
# Dependency directories
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
**/dist/
**/dist-ssr/
**/.vite/
**/.svelte-kit/
**/.turbo/
*.tsbuildinfo

# ── Dynamic Runtime State, Backups & Host Snapshots ───────────────────────────
# Dynamic backups captured during optimization (host-specific)
Backups/*
!Backups/.gitkeep
active_state.json
**/active_state.json

# Quarantined shortcuts and local backup files
*.ugm_backup
*.bak
*.backup
*.old
*.orig

# ── Logs & Temporary Files ───────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.transcript.txt
*PowerShell_transcript.*
.history/

# ── Test, Diagnostics & Benchmark Artifacts ──────────────────────────────────
UGM_Test_*
TestResults/
coverage/
.nyc_output/
*.prof
*.vprof

# ── Windows Operating System Artifacts ───────────────────────────────────────
[Tt]humbs.db
[Tt]humbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
System Volume Information/

# ── macOS & Linux System Artifacts ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.directory

# ── IDEs, Code Editors & Workspaces ──────────────────────────────────────────
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio / JetBrains / Rider
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.iml
cmake-build-*/

# Vim / Emacs / Sublime swap files
*.swp
*.swo
*.sw?
*.sublime-project
*.sublime-workspace
.#*
#*#

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cer
*.crt
