.bin/
bin/
releases/
release/
*.wixobj
*.wixpdb
*.wixbin

# ── Rust & Cargo Build System ─────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk

# ── Dynamic Runtime State, Backups & Host Snapshots ───────────────────────────
