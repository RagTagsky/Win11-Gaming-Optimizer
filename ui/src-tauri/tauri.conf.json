{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltraGamingMode",
  "version": "3.5.1",
  "identifier": "com.ultragamingmode.optimizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ultra Gaming Mode v3.5.1",
        "width": 960,
        "height": 680,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#0c0e12",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "templates/installer.nsi"
      },
      "wix": {
        "upgradeCode": "7630b84c-95f6-58d0-8c30-969d061c38b0",
        "template": "templates/main.wxs"
      }
    },
    "resources": {
      "../../UltraGamingMode.ps1": "UltraGamingMode.ps1",
      "../../UltraGamingMode.bat": "UltraGamingMode.bat",
      "../../Core/*.ps1": "Core/",
      "../../Config/*.json": "Config/",
      "../../Tests/Verify-UniversalEngine.ps1": "Tests/Verify-UniversalEngine.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
