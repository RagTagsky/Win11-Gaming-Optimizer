        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.color;
        stroke-width: root.stroke-width;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 5 12.5 L 10 17.5 L 19.5 7";
    }
}

