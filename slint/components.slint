// ============================================================================
// Reusable Themed Surface Card (with optional top specular highlight)
// ============================================================================

export component SurfaceCard inherits Rectangle {
    in property <color> stroke-color: ThemeTokens.border-subtle;
    in property <length> radius: 12px;

    border-radius: root.radius;
    background: ThemeTokens.bg-surface;
    border-width: 1px;
    border-color: root.stroke-color;
    drop-shadow-offset-y: ThemeTokens.shadow-card-offset-y;
    drop-shadow-blur: ThemeTokens.shadow-card-blur;
    drop-shadow-color: ThemeTokens.shadow-card-color;

    if ThemeTokens.has-surface-top-highlight : Rectangle {
        x: root.radius;
        y: 1px;
        width: max(0px, parent.width - 2 * root.radius);
        height: 1px;
        background: ThemeTokens.surface-top-highlight;
    }

    @children
}

// ============================================================================
// Fully Themed Vertical ScrollView (uses ThemeTokens.scrollbar-thumb*)
// ============================================================================

component ThemedScrollBar inherits Rectangle {
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;

    property <length> pad: 4px;
    property <length> track-size: max(1px, root.height - 2 * root.pad);
    property <length> thumb-height: root.maximum <= 0px ? 0px : max(28px, min(root.track-size, root.track-size * (root.page-size / (root.maximum + root.page-size))));
    property <length> thumb-y: root.pad + (root.track-size - root.thumb-height) * (root.maximum > 0px ? clamp(-root.value / root.maximum, 0.0, 1.0) : 0.0);
    property <bool> active: bar-ta.has-hover || bar-ta.pressed;

    width: 12px;
    background: transparent;
    visible: root.maximum > 0px;

    Rectangle {
        x: root.active ? 3px : 5px;
        y: root.thumb-y;
        width: root.active ? 6px : 4px;
        height: root.thumb-height;
        border-radius: self.width / 2;
        background: root.active ? ThemeTokens.scrollbar-thumb-hover : ThemeTokens.scrollbar-thumb;

        animate width, x { duration: 120ms; easing: ease-out; }
    }

    bar-ta := TouchArea {
        property <length> start-value: 0px;
        property <length> start-y: 0px;

        mouse-cursor: pointer;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                if (root.maximum > 0px && root.track-size > root.thumb-height && (self.mouse-y < root.thumb-y || self.mouse-y > root.thumb-y + root.thumb-height)) {
                    root.value = -clamp(
                        (self.mouse-y - root.pad - root.thumb-height / 2) * (root.maximum / (root.track-size - root.thumb-height)),
                        0px,
                        root.maximum
                    );
                }
                self.start-value = -root.value;
                self.start-y = self.mouse-y;
            }
        }

        moved => {
            if (self.pressed && root.maximum > 0px && root.track-size > root.thumb-height) {
                root.value = -clamp(
                    self.start-value + (self.mouse-y - self.start-y) * (root.maximum / (root.track-size - root.thumb-height)),
                    0px,
                    root.maximum
                );
            }
        }

        scroll-event(event) => {
            if (event.delta-y != 0px) {
                root.value = clamp(root.value + event.delta-y, -root.maximum, 0px);
                return accept;
            }
            return reject;
        }
    }
}

export component ThemedScrollView inherits Rectangle {
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-y <=> flickable.content-y;

    background: transparent;
    clip: true;

    flickable := Flickable {
        mouse-drag-pan-enabled: false;
        width: parent.width;
        height: parent.height;
        content-y <=> vbar.value;

        @children
    }

    vbar := ThemedScrollBar {
        x: parent.width - self.width;
        y: 0px;
        height: parent.height;
        maximum: max(0px, flickable.content-height - flickable.height);
        page-size: max(1px, flickable.height);
    }
}

// ============================================================================
// Fully Themed Single-Line Text Input (replaces un-themed std-widgets LineEdit)
// ============================================================================

export component ThemedLineEdit inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder-text: "";
    in property <bool> show-search-icon: false;
    in property <bool> monospace: false;
    in property <bool> enabled: true;
    out property <bool> has-focus <=> ti.has-focus;

    callback edited(string);
    callback accepted(string);

    height: 34px;
    border-radius: 8px;
    clip: true;
    opacity: root.enabled ? 1.0 : 0.55;
    background: ThemeTokens.bg-elevated;
    border-width: 1px;
    border-color: ti.has-focus ? ThemeTokens.focus-ring : (bg-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-input);
    forward-focus: ti;

    bg-ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => {
            ti.focus();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;

        if root.show-search-icon : VerticalLayout {
            alignment: center;
            IconSearch {
                size: 14px;
                color: ti.has-focus ? ThemeTokens.accent-text : ThemeTokens.text-muted;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            clip: true;
            background: transparent;

            if root.text == "" : Text {
                x: 0px;
                width: parent.width;
                height: parent.height;
                text: root.placeholder-text;
                font-family: root.monospace ? ThemeTokens.font-mono : ThemeTokens.font-sans;
                font-size: 12px;
                color: ThemeTokens.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            ti-scroll := Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                interactive: false;
                content-width: max(self.width, ti.preferred-width + 4px);
                content-height: self.height;

                ti := TextInput {
                    x: 0px;
                    y: 0px;
                    width: max(parent.width, self.preferred-width + 4px);
                    height: parent.height;
                    single-line: true;
                    enabled: root.enabled;
                    font-family: root.monospace ? ThemeTokens.font-mono : ThemeTokens.font-sans;
                    font-size: 12px;
                    color: ThemeTokens.text-primary;
                    selection-background-color: ThemeTokens.accent-solid;
                    selection-foreground-color: ThemeTokens.text-on-solid;
                    vertical-alignment: center;

                    edited => {
                        if (self.preferred-width > ti-scroll.width - 4px) {
                            ti-scroll.content-x = ti-scroll.width - 4px - self.preferred-width;
                        } else {
                            ti-scroll.content-x = 0px;
                        }
                        root.edited(self.text);
                    }

                    accepted => {
                        root.accepted(self.text);
                    }
                }
            }
        }

        if root.text != "" && root.enabled : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 5px;
                background: clr-ta.has-hover ? ThemeTokens.bg-hover : transparent;

                clr-ta := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Очистить поле";
                    clicked => {
                        root.text = "";
                        ti-scroll.content-x = 0px;
                        root.edited("");
                        ti.focus();
                    }
                }

                IconClose {
                    x: 5px;
                    y: 5px;
                    size: 10px;
                    color: clr-ta.has-hover ? ThemeTokens.text-primary : ThemeTokens.text-muted;
                }
            }
        }
    }
}

// ============================================================================
// Fully Themed Toggle Switch (animated thumb, keyboard accessible)
// ============================================================================

export component ThemedSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> accessible-name: "";
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: 13px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.checked ? (sw-ta.has-hover ? ThemeTokens.accent-solid-hover : ThemeTokens.accent-solid) : (sw-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.switch-off-bg);
    border-width: 1px;
    border-color: sw-fs.has-focus ? ThemeTokens.focus-ring : (root.checked ? ThemeTokens.accent-solid : ThemeTokens.switch-off-border);

    sw-fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.toggled();
                return accept;
            }
            return reject;
        }

        sw-ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            accessible-role: checkbox;
            accessible-checked: root.checked;
            accessible-label: root.accessible-name;
            clicked => {
                sw-fs.focus();
                root.toggled();
            }
        }
    }

    Rectangle {
        x: root.checked ? 23px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? ThemeTokens.text-on-solid : ThemeTokens.switch-off-thumb;

        animate x { duration: 140ms; easing: ease-out; }
    }
}
