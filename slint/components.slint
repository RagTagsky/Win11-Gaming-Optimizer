import { ThemeTokens } from "theme.slint";

// ============================================================================
// Crisp Vector Icons (24x24 viewbox, unified stroke weight, theme-colored)
// ============================================================================

export component IconBolt {
    in property <color> color: ThemeTokens.text-on-solid;
    in property <length> size: 15px;
    in property <bool> filled: true;
    width: root.size;
    height: root.size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.filled ? root.color : transparent;
        stroke: root.color;
        stroke-width: root.filled ? 1px : 1.75px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 13 2 L 4.5 13.5 H 12 L 11 22 L 19.5 10.5 H 12 Z";
    }
}

