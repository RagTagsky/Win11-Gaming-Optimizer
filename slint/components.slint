export component IconMaximize {
    in property <color> color: ThemeTokens.text-secondary;
    in property <bool> is-maximized: false;
    width: 12px;
    height: 12px;

    if !root.is-maximized : Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 12;
        fill: transparent;
        stroke: root.color;
        stroke-width: 1.15px;
        stroke-line-join: round;
        commands: "M 2 2 H 10 V 10 H 2 Z";
    }

    if root.is-maximized : Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 12;
        fill: transparent;
        stroke: root.color;
        stroke-width: 1.15px;
        stroke-line-join: round;
        commands: "M 1.8 3.8 H 8.2 V 10.2 H 1.8 Z M 3.8 3.8 V 1.8 H 10.2 V 8.2 H 8.2";
    }
}

