export component IconChevron {
    in property <color> color: ThemeTokens.text-secondary;
    in property <bool> down: false;
    in property <length> size: 13px;
    width: root.size;
    height: root.size;

    if root.down : Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.color;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 6 9 L 12 15 L 18 9";
    }

    if !root.down : Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.color;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 6 15 L 12 9 L 18 15";
    }
}

