import { ThemeTokens } from "theme.slint";
import { ThemedScrollView, IconChevron } from "components.slint";

export struct LogRowItem {
    timestamp: string,
    level: string,
    message: string,
}

export component LogConsole inherits Rectangle {
    in property <[LogRowItem]> logs: [];
    in property <int> log-count: 0;
    in-out property <bool> expanded: false;

    callback clear-logs();

    height: root.expanded ? 176px : 36px;
    background: ThemeTokens.bg-elevated;

    VerticalLayout {
        spacing: 0px;

        // Crisp 1px top divider (never overpainted by top bar)
        Rectangle {
            height: 1px;
            width: 100%;
            background: ThemeTokens.border-subtle;
        }

        // Top Bar
        Rectangle {
            height: 35px;
            background: ThemeTokens.bg-elevated;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 26px;
                        border-radius: 6px;
                        background: exp-ta.pressed ? ThemeTokens.bg-active : (exp-ta.has-hover ? ThemeTokens.bg-hover : transparent);
                        border-width: exp-fs.has-focus ? 1px : 0px;
                        border-color: ThemeTokens.focus-ring;

                        exp-fs := FocusScope {
                            key-pressed(event) => {
                                if (event.text == " " || event.text == "\n") {
                                    root.expanded = !root.expanded;
                                    return accept;
                                }
                                return reject;
                            }

                            exp-ta := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: root.expanded ? "Свернуть журнал событий" : "Развернуть журнал событий";
                                clicked => {
                                    exp-fs.focus();
                                    root.expanded = !root.expanded;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 7px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                IconChevron {
                                    size: 12px;
                                    down: root.expanded;
                                    color: ThemeTokens.text-secondary;
                                }
                            }

                            Text {
                                text: "Журнал событий";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    border-radius: 9px;
                                    background: ThemeTokens.bg-surface;
                                    border-width: 1px;
                                    border-color: ThemeTokens.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 7px;
                                        padding-right: 7px;
                                        Text {
                                            text: "" + root.log-count;
                                            font-family: ThemeTokens.font-mono;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            color: ThemeTokens.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        border-radius: 6px;
                        opacity: root.log-count > 0 ? 1.0 : 0.5;
                        background: clr-ta.pressed ? ThemeTokens.bg-active : (clr-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-surface);
                        border-width: 1px;
                        border-color: clr-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;

                        clr-ta := TouchArea {
                            enabled: root.log-count > 0;
                            mouse-cursor: root.log-count > 0 ? pointer : default;
                            accessible-role: button;
                            accessible-label: "Очистить журнал";
                            clicked => {
                                root.clear-logs();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "Очистить";
                                font-size: 11px;
                                font-weight: 500;
                                color: root.log-count > 0 ? ThemeTokens.text-secondary : ThemeTokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        if root.expanded : Rectangle {
            height: 1px;
            width: 100%;
            background: ThemeTokens.border-subtle;
        }

        if root.expanded : Rectangle {
            vertical-stretch: 1;
            background: ThemeTokens.bg-surface;

            ThemedScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    padding-top: 9px;
                    padding-bottom: 9px;
                    spacing: 4px;

                    if root.log-count == 0 : Text {
                        text: "Журнал событий пуст.";
                        font-size: 11.5px;
                        color: ThemeTokens.text-muted;
                    }

                    for entry in root.logs : HorizontalLayout {
                        spacing: 8px;

                        Text {
                            width: 72px;
                            text: "[" + entry.timestamp + "]";
                            font-family: ThemeTokens.font-mono;
                            font-size: 11px;
                            color: ThemeTokens.text-muted;
                        }

                        Text {
                            width: 38px;
                            text: entry.level == "success" ? "OK" : (entry.level == "warn" ? "WARN" : (entry.level == "error" ? "ERR" : "INFO"));
                            font-family: ThemeTokens.font-mono;
                            font-size: 11px;
                            font-weight: 700;
                            color: entry.level == "success" ? ThemeTokens.status-active-text : (entry.level == "warn" ? ThemeTokens.status-warn-text : (entry.level == "error" ? ThemeTokens.status-danger-text : ThemeTokens.accent-text));
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: entry.message;
                            font-size: 11.5px;
                            color: ThemeTokens.text-primary;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

export component TooltipOverlay inherits Rectangle {
    in property <bool> visible-tooltip: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> safety-level: "optional";
    in property <string> summary: "";
    in property <string> impact: "";
    in property <string> meta-note: "";

    callback close-tooltip();

    visible: root.visible-tooltip;
    background: ThemeTokens.backdrop-overlay;

    TouchArea {
        clicked => {
            root.close-tooltip();
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 472px;
                border-radius: 14px;
                background: ThemeTokens.bg-surface;
                border-width: 1px;
                border-color: ThemeTokens.border-strong;
                drop-shadow-offset-y: ThemeTokens.shadow-dialog-offset-y;
                drop-shadow-blur: ThemeTokens.shadow-dialog-blur;
                drop-shadow-color: ThemeTokens.shadow-dialog-color;

                if ThemeTokens.has-surface-top-highlight : Rectangle {
                    x: 14px;
                    y: 1px;
                    width: max(0px, parent.width - 28px);
                    height: 1px;
                    background: ThemeTokens.surface-top-highlight;
                }

                TouchArea {}

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: root.title;
                                font-size: 15px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                                overflow: elide;
                            }

                            Text {
                                text: root.subtitle;
                                font-family: ThemeTokens.font-mono;
                                font-size: 11px;
                                color: ThemeTokens.text-muted;
                            }
                        }

                        // Safety Verdict Badge
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: root.safety-level == "safe" ? ThemeTokens.status-active-soft : (root.safety-level == "protected" ? ThemeTokens.status-danger-soft : ThemeTokens.status-warn-soft);
                                border-width: 1px;
                                border-color: root.safety-level == "safe" ? ThemeTokens.status-active-border : (root.safety-level == "protected" ? ThemeTokens.status-danger-border : ThemeTokens.status-warn-border);

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.safety-level == "safe" ? "Можно выключить" : (root.safety-level == "protected" ? "Нельзя выключать" : "По желанию");
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.safety-level == "safe" ? ThemeTokens.status-active-text : (root.safety-level == "protected" ? ThemeTokens.status-danger-text : ThemeTokens.status-warn-text);
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.summary;
                        font-size: 12.5px;
                        color: ThemeTokens.text-secondary;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: ThemeTokens.bg-elevated;
                        border-width: 1px;
                        border-color: ThemeTokens.border-subtle;

                        VerticalLayout {
                            padding: 11px;
                            spacing: 3px;

                            Text {
                                text: "Влияние отключения в Gaming Mode";
                                font-size: 11px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: root.impact;
                                font-size: 11.5px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            horizontal-stretch: 1;
                            text: root.meta-note;
                            font-family: ThemeTokens.font-mono;
                            font-size: 11px;
                            color: ThemeTokens.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: 7px;
                            background: ok-ta.pressed ? ThemeTokens.accent-solid-active : (ok-ta.has-hover ? ThemeTokens.accent-solid-hover : ThemeTokens.accent-solid);
                            border-width: ok-fs.has-focus ? 2px : 0px;
                            border-color: ThemeTokens.focus-ring;

                            ok-fs := FocusScope {
                                enabled: root.visible-tooltip;
                                key-pressed(event) => {
                                    if (event.text == Key.Escape || event.text == Key.Return || event.text == " " || event.text == "\n") {
                                        root.close-tooltip();
                                        return accept;
                                    }
                                    if (event.text == Key.Tab || event.text == Key.Backtab) {
                                        return accept;
                                    }
                                    return reject;
                                }

                                ok-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    accessible-role: button;
                                    accessible-label: "Закрыть описание";
                                    clicked => {
                                        root.close-tooltip();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: "Понятно";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: ThemeTokens.text-on-solid;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    public function focus-primary() {
        ok-fs.focus();
    }
}

export component ConfirmDialogOverlay inherits Rectangle {
    in property <bool> visible-confirm: false;
    in property <string> title: "";
    in property <string> description: "";
    in property <string> confirm-label: "Подтвердить";
    in property <string> cancel-label: "Отмена";
    in property <string> tone: "warn";

    callback confirm-accepted();
    callback confirm-cancelled();

    visible: root.visible-confirm;
    background: ThemeTokens.backdrop-overlay;

    TouchArea {
        clicked => {
            root.confirm-cancelled();
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 448px;
                border-radius: 14px;
                background: ThemeTokens.bg-surface;
                border-width: 1px;
                border-color: ThemeTokens.border-strong;
                drop-shadow-offset-y: ThemeTokens.shadow-dialog-offset-y;
                drop-shadow-blur: ThemeTokens.shadow-dialog-blur;
                drop-shadow-color: ThemeTokens.shadow-dialog-color;

                if ThemeTokens.has-surface-top-highlight : Rectangle {
                    x: 14px;
                    y: 1px;
                    width: max(0px, parent.width - 28px);
                    height: 1px;
                    background: ThemeTokens.surface-top-highlight;
                }

                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: root.title;
                        font-size: 15.5px;
                        font-weight: 600;
                        color: ThemeTokens.text-primary;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.description;
                        font-size: 12.5px;
                        color: ThemeTokens.text-secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        padding-top: 4px;
                        spacing: 8px;

                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: cnl-ta.pressed ? ThemeTokens.bg-active : (cnl-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: cnl-fs.has-focus ? 2px : 1px;
                            border-color: cnl-fs.has-focus ? ThemeTokens.focus-ring : (cnl-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle);

                            cnl-fs := FocusScope {
                                enabled: root.visible-confirm;
                                key-pressed(event) => {
                                    if (event.text == Key.Escape || event.text == Key.Return || event.text == " " || event.text == "\n") {
                                        root.confirm-cancelled();
                                        return accept;
                                    }
                                    if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.RightArrow || event.text == Key.LeftArrow) {
                                        acc-fs.focus();
                                        return accept;
                                    }
                                    return reject;
                                }

                                cnl-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    accessible-role: button;
                                    accessible-label: root.cancel-label;
                                    clicked => {
                                        root.confirm-cancelled();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: root.cancel-label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: ThemeTokens.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: root.tone == "danger" ? (acc-ta.has-hover ? ThemeTokens.status-danger-solid-hover : ThemeTokens.status-danger-solid) : (acc-ta.pressed ? ThemeTokens.accent-solid-active : (acc-ta.has-hover ? ThemeTokens.accent-solid-hover : ThemeTokens.accent-solid));
                            border-width: acc-fs.has-focus ? 2px : 0px;
                            border-color: ThemeTokens.focus-ring;

                            acc-fs := FocusScope {
                                enabled: root.visible-confirm;
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.confirm-cancelled();
                                        return accept;
                                    }
                                    if (event.text == Key.Return || event.text == " " || event.text == "\n") {
                                        root.confirm-accepted();
                                        return accept;
                                    }
                                    if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.RightArrow || event.text == Key.LeftArrow) {
                                        cnl-fs.focus();
                                        return accept;
                                    }
                                    return reject;
                                }

                                acc-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    accessible-role: button;
                                    accessible-label: root.confirm-label;
                                    clicked => {
                                        root.confirm-accepted();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: root.confirm-label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: ThemeTokens.text-on-solid;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    public function focus-cancel() {
        cnl-fs.focus();
    }
}
