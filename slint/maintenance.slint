import { ThemeTokens } from "theme.slint";
import { SurfaceCard, ThemedScrollView, IconClose } from "components.slint";

export component MaintenanceView inherits Rectangle {
    in property <string> running-repair: "";
    in property <string> status-text: "";
    in property <bool> status-is-error: false;

    callback run-safe-repair(string);
    callback request-critical-repair(string);
    callback dismiss-status();

    background: transparent;

    ThemedScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header Card
            SurfaceCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 3px;

                    Text {
                        text: "Обслуживание и восстановление";
                        font-size: 14.5px;
                        font-weight: 600;
                        color: ThemeTokens.text-primary;
                    }

                    Text {
                        text: "Инструменты очистки памяти, диагностики целостности и безопасного сброса системных подсистем Windows 11.";
                        font-size: 12px;
                        color: ThemeTokens.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            // Status Banner (bounded height so long logs stay crisp and readable)
            if root.status-text != "" : Rectangle {
                border-radius: 10px;
                background: root.status-is-error ? ThemeTokens.status-danger-soft : ThemeTokens.status-active-soft;
                border-width: 1px;
                border-color: root.status-is-error ? ThemeTokens.status-danger-border : ThemeTokens.status-active-border;
                clip: true;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        font-size: 12px;
                        font-weight: 500;
                        color: root.status-is-error ? ThemeTokens.status-danger-text : ThemeTokens.status-active-text;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: cls-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-surface;

                            cls-ta := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "Скрыть результат операции";
                                clicked => { root.dismiss-status(); }
                            }

                            IconClose {
                                x: 8px;
                                y: 8px;
                                size: 10px;
                                color: ThemeTokens.text-secondary;
                            }
                        }
                    }
                }
            }

            // Everyday Safe Actions (3 cards)
            Text {
                text: "Быстрое обслуживание и диагностика";
                font-size: 12.5px;
                font-weight: 600;
                color: ThemeTokens.text-muted;
            }

            HorizontalLayout {
                spacing: 12px;

                // 1. Clean Standby RAM
                SurfaceCard {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Очистить кэш ОЗУ";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Освобождает резервную память (Standby List) через NtSetSystemInformation, убирая подтормаживания при длительных сессиях.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "memory") ? 1.0 : 0.55;
                            background: mem-ta.pressed ? ThemeTokens.bg-active : (mem-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: 1px;
                            border-color: mem-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;

                            mem-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.run-safe-repair("memory"); }
                            }

                            Text {
                                text: root.running-repair == "memory" ? "Выполняется…" : "Очистить кэш ОЗУ";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 2. Verify Configs
                SurfaceCard {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Проверить конфиги";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Запускает автоматическую диагностику Verify-UniversalEngine.ps1 для проверки JSON-конфигов, UTF-8 и инвариантов движка.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "verify") ? 1.0 : 0.55;
                            background: ver-ta.pressed ? ThemeTokens.bg-active : (ver-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: 1px;
                            border-color: ver-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;

                            ver-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.run-safe-repair("verify"); }
                            }

                            Text {
                                text: root.running-repair == "verify" ? "Выполняется…" : "Проверить конфиги";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 3. Repair Services
                SurfaceCard {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Восстановить службы";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Возвращает исходные типы запуска всем службам из резервного снимка после нештатного завершения игры или сбоя питания.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "services") ? 1.0 : 0.55;
                            background: svc-ta.pressed ? ThemeTokens.bg-active : (svc-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: 1px;
                            border-color: svc-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;

                            svc-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.run-safe-repair("services"); }
                            }

                            Text {
                                text: root.running-repair == "services" ? "Выполняется…" : "Восстановить службы";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Deep Reset & Windows 11 Components (2x2 Grid with Confirmation Dialog)
            Text {
                text: "Глубокий сброс и компоненты Windows 11 (с подтверждением)";
                font-size: 12.5px;
                font-weight: 600;
                color: ThemeTokens.text-muted;
            }

            GridLayout {
                spacing: 12px;

                // 1. Flush GPU Shader Cache
                SurfaceCard {
                    row: 0;
                    col: 0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Очистить кэш шейдеров GPU";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Удаляет накопленные скомпилированные шейдеры DirectX, NVIDIA, AMD и Intel для устранения статтеров и артефактов.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "shaders") ? 1.0 : 0.55;
                            background: sh-ta.pressed ? ThemeTokens.bg-active : (sh-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.status-warn-soft);
                            border-width: 1px;
                            border-color: ThemeTokens.status-warn-border;

                            sh-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.request-critical-repair("shaders"); }
                            }

                            Text {
                                text: root.running-repair == "shaders" ? "Выполняется…" : "Очистить шейдеры…";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.status-warn-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 2. Reset DWM Display Stack
                SurfaceCard {
                    row: 0;
                    col: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Сбросить графический стек (DWM)";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Перезапускает композитор рабочего стола и переинициализирует вывод дисплея при зависании картинки или сбое HDR.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "display") ? 1.0 : 0.55;
                            background: dp-ta.pressed ? ThemeTokens.bg-active : (dp-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.status-warn-soft);
                            border-width: 1px;
                            border-color: ThemeTokens.status-warn-border;

                            dp-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.request-critical-repair("display"); }
                            }

                            Text {
                                text: root.running-repair == "display" ? "Выполняется…" : "Сбросить дисплей…";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.status-warn-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 3. Apply Win11 Debloat
                SurfaceCard {
                    row: 1;
                    col: 0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Оптимизация Windows 11 (Debloat)";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Отключает избыточную телеметрию и фоновые виджеты Windows 11 с сохранением резервной копии для полного отката.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "debloat") ? 1.0 : 0.55;
                            background: db-ta.pressed ? ThemeTokens.bg-active : (db-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.status-danger-soft);
                            border-width: 1px;
                            border-color: ThemeTokens.status-danger-border;

                            db-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.request-critical-repair("debloat"); }
                            }

                            Text {
                                text: root.running-repair == "debloat" ? "Выполняется…" : "Применить Win11 Debloat…";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.status-danger-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 4. Restore Win11 Debloat
                SurfaceCard {
                    row: 1;
                    col: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "Откат Win11 Debloat";
                            font-size: 13.5px;
                            font-weight: 600;
                            color: ThemeTokens.text-primary;
                        }

                        Text {
                            vertical-stretch: 1;
                            text: "Возвращает стандартные настройки Windows 11 для телеметрии, виджетов и вспомогательных системных компонентов.";
                            font-size: 12px;
                            color: ThemeTokens.text-secondary;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            opacity: (root.running-repair == "" || root.running-repair == "restore_debloat") ? 1.0 : 0.55;
                            background: rd-ta.pressed ? ThemeTokens.bg-active : (rd-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.status-warn-soft);
                            border-width: 1px;
                            border-color: ThemeTokens.status-warn-border;

                            rd-ta := TouchArea {
                                enabled: root.running-repair == "";
                                mouse-cursor: root.running-repair == "" ? pointer : default;
                                accessible-role: button;
                                clicked => { root.request-critical-repair("restore_debloat"); }
                            }

                            Text {
                                text: root.running-repair == "restore_debloat" ? "Выполняется…" : "Откатить Win11 Debloat…";
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.status-warn-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
