import { ThemeTokens } from "theme.slint";
import {
    SurfaceCard,
    ThemedScrollView,
    IconBolt,
    IconCheck,
    IconClock,
    IconGpu,
    IconCpu,
    IconMemory,
    IconShield,
    IconExternal,
} from "components.slint";

component TelemetryTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> monospace-value: false;
    in property <bool> accent-value: false;

    min-height: 58px;
    border-radius: 8px;
    background: ThemeTokens.bg-elevated;
    border-width: 1px;
    border-color: ThemeTokens.border-subtle;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 3px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 500;
            color: ThemeTokens.text-muted;
        }

        Text {
            text: root.value;
            font-family: root.monospace-value ? ThemeTokens.font-mono : ThemeTokens.font-sans;
            font-size: root.monospace-value ? 12px : 13px;
            font-weight: 600;
            color: root.accent-value ? ThemeTokens.status-active-text : ThemeTokens.text-primary;
            overflow: elide;
        }
    }
}

export component DashboardView inherits Rectangle {
    in property <string> mode: "Normal";
    in property <string> active-since: "";
    in property <bool> is-busy: false;
    in property <bool> timer-locked: false;
    in property <string> cpu-name: "Определение процессора…";
    in property <string> gpu-name: "Определение видеоадаптера…";
    in property <string> ram-summary: "Определение объёма ОЗУ…";
    in property <string> display-summary: "Основной дисплей";
    in property <string> dpc-latency: "Потоковый DPC (оптимально)";
    in property <string> mpo-status: "Штатный конвейер DWM (без мерцания)";
    in property <string> timer-resolution: "1.000 мс (штатный)";
    in property <string> app-version: "4.1.0";
    in property <string> latest-version: "4.1.0";
    in property <bool> has-update: false;
    in property <bool> is-checking-updates: false;
    in property <bool> is-installing-update: false;
    in property <bool> update-is-error: false;
    in property <string> update-status-text: "Установлена актуальная версия v4.1.0.";
    in property <int> disabled-services-count: 205;
    in property <int> disabled-processes-count: 40;

    callback toggle-mode();
    callback finish-pending-restore();
    callback reboot-pc();
    callback toggle-timer-lock();
    callback unlock-timer();
    callback check-updates();
    callback install-update();
    callback open-releases-page();

    background: transparent;

    ThemedScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // 1. Hero Status Card
            SurfaceCard {
                stroke-color: root.mode == "Gaming" ? ThemeTokens.status-active-border : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-border : ThemeTokens.border-subtle);

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 14px;

                        // Mode Status Emblem
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 10px;
                                background: root.mode == "Gaming" ? ThemeTokens.status-active-soft : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-soft : ThemeTokens.accent-soft);
                                border-width: 1px;
                                border-color: root.mode == "Gaming" ? ThemeTokens.status-active-border : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-border : ThemeTokens.accent-border);

                                if root.mode == "Gaming" : IconCheck {
                                    x: 13px;
                                    y: 13px;
                                    size: 18px;
                                    color: ThemeTokens.status-active-text;
                                }

                                if root.mode == "Armed" || root.mode == "RestoringPending" : IconClock {
                                    x: 13px;
                                    y: 13px;
                                    size: 18px;
                                    color: ThemeTokens.status-warn-text;
                                }

                                if root.mode != "Gaming" && root.mode != "Armed" && root.mode != "RestoringPending" : IconBolt {
                                    x: 13px;
                                    y: 13px;
                                    size: 18px;
                                    filled: false;
                                    color: ThemeTokens.accent-text;
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Text {
                                    text: root.mode == "Gaming" ? "Игровой режим AAA активен" : (root.mode == "Armed" ? "Ожидает перезагрузки ПК" : (root.mode == "RestoringPending" ? "Ожидает завершения возврата" : "Штатный режим Windows"));
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: ThemeTokens.text-primary;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 11px;
                                        background: root.mode == "Gaming" ? ThemeTokens.status-active-soft : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-soft : ThemeTokens.bg-elevated);
                                        border-width: 1px;
                                        border-color: root.mode == "Gaming" ? ThemeTokens.status-active-border : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-border : ThemeTokens.border-subtle);

                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            spacing: 5px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    background: root.mode == "Gaming" ? ThemeTokens.status-active-text : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-text : ThemeTokens.text-muted);
                                                }
                                            }

                                            Text {
                                                text: root.mode == "Gaming" ? "Активен" : (root.mode == "Armed" ? "Ждёт перезагрузки" : (root.mode == "RestoringPending" ? "Не завершено" : "Штатный"));
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: root.mode == "Gaming" ? ThemeTokens.status-active-text : (root.mode == "Armed" || root.mode == "RestoringPending" ? ThemeTokens.status-warn-text : ThemeTokens.text-secondary);
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.mode == "Gaming" ? "Фоновые службы приостановлены, активен единый игровой конвейер AAA с защитой сетевых фильтров." : (root.mode == "Armed" ? "Игровой конвейер AAA подготовлен к следующему запуску Windows. Перезагрузите ПК для активации." : (root.mode == "RestoringPending" ? "Системные службы восстановлены, осталось вернуть ярлыки автозагрузки профиля пользователя." : "Все службы работают в штатном порядке. Включите игровой режим AAA перед запуском игры."));
                                font-size: 12.5px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }

                            if root.active-since != "" : Text {
                                text: "Активен с " + root.active-since;
                                font-family: ThemeTokens.font-mono;
                                font-size: 11px;
                                color: ThemeTokens.text-muted;
                            }
                        }

                        // Primary + Secondary Actions
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Rectangle {
                                    height: 38px;
                                    border-radius: 8px;
                                    background: root.is-busy ? ThemeTokens.bg-elevated : ((root.mode == "Gaming" || root.mode == "Armed") ? (toggle-ta.has-hover ? ThemeTokens.status-danger-solid-hover : ThemeTokens.status-danger-solid) : (toggle-ta.pressed ? ThemeTokens.accent-solid-active : (toggle-ta.has-hover ? ThemeTokens.accent-solid-hover : ThemeTokens.accent-solid)));

                                    toggle-ta := TouchArea {
                                        enabled: !root.is-busy;
                                        mouse-cursor: !root.is-busy ? pointer : default;
                                        accessible-role: button;
                                        accessible-label: (root.mode == "Gaming" || root.mode == "Armed") ? "Вернуть штатный режим" : (root.mode == "RestoringPending" ? "Завершить восстановление" : "Включить игровой режим");
                                        clicked => {
                                            if (root.mode == "RestoringPending") {
                                                root.finish-pending-restore();
                                            } else {
                                                root.toggle-mode();
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        Text {
                                            text: root.is-busy ? "Выполняется…" : ((root.mode == "Gaming" || root.mode == "Armed") ? "Вернуть штатный режим" : (root.mode == "RestoringPending" ? "Завершить возврат" : "Включить игровой режим"));
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: root.is-busy ? ThemeTokens.text-muted : ThemeTokens.text-on-solid;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 38px;
                                    border-radius: 8px;
                                    opacity: root.is-busy ? 0.55 : 1.0;
                                    background: root.mode == "Armed" ? ThemeTokens.status-warn-soft : (reboot-ta.pressed ? ThemeTokens.bg-active : (reboot-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated));
                                    border-width: 1px;
                                    border-color: root.mode == "Armed" ? ThemeTokens.status-warn-border : (reboot-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle);

                                    reboot-ta := TouchArea {
                                        enabled: !root.is-busy;
                                        mouse-cursor: !root.is-busy ? pointer : default;
                                        accessible-role: button;
                                        accessible-label: "Перезагрузить ПК";
                                        clicked => {
                                            root.reboot-pc();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "Перезагрузить ПК";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: root.mode == "Armed" ? ThemeTokens.status-warn-text : ThemeTokens.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // RestoringPending Banner
                    if root.mode == "RestoringPending" : Rectangle {
                        border-radius: 8px;
                        background: ThemeTokens.status-warn-soft;
                        border-width: 1px;
                        border-color: ThemeTokens.status-warn-border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 12px;

                            Text {
                                horizontal-stretch: 1;
                                text: "Требуется завершить восстановление ярлыков автозагрузки и параметров профиля пользователя после перезагрузки.";
                                font-size: 12px;
                                font-weight: 500;
                                color: ThemeTokens.status-warn-text;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 32px;
                                    border-radius: 7px;
                                    opacity: root.is-busy ? 0.55 : 1.0;
                                    background: fin-ta.pressed ? ThemeTokens.bg-active : (fin-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-surface);
                                    border-width: 1px;
                                    border-color: ThemeTokens.status-warn-border;

                                    fin-ta := TouchArea {
                                        enabled: !root.is-busy;
                                        mouse-cursor: !root.is-busy ? pointer : default;
                                        accessible-role: button;
                                        accessible-label: "Завершить восстановление";
                                        clicked => {
                                            root.finish-pending-restore();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: "Завершить восстановление";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: ThemeTokens.status-warn-text;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Unified AAA Gaming Pipeline Card (clean 2x2 architectural layout)
            SurfaceCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: "Единый игровой конвейер AAA";
                                font-size: 14.5px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: "Все параметры кадра, ядра, памяти и сети применяются автоматически в едином режиме.";
                                font-size: 12px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                border-radius: 7px;
                                background: ThemeTokens.bg-elevated;
                                border-width: 1px;
                                border-color: ThemeTokens.border-subtle;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: root.mode == "Gaming" ? ThemeTokens.status-active-text : ThemeTokens.accent-text;
                                        }
                                    }

                                    Text {
                                        text: "Служб: " + root.disabled-services-count + " · Процессов: " + root.disabled-processes-count;
                                        font-family: ThemeTokens.font-mono;
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: ThemeTokens.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    GridLayout {
                        spacing: 10px;

                        // Stage 1: Graphics & DWM
                        Rectangle {
                            row: 0;
                            col: 0;
                            border-radius: 8px;
                            background: ThemeTokens.bg-elevated;
                            border-width: 1px;
                            border-color: ThemeTokens.border-subtle;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        IconGpu {
                                            size: 15px;
                                            color: ThemeTokens.accent-text;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Графика и DWM";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: ThemeTokens.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "Flip + VRR · HAGS";
                                        font-family: ThemeTokens.font-mono;
                                        font-size: 10.5px;
                                        font-weight: 500;
                                        color: ThemeTokens.accent-text;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Плавный вывод кадра, штатный MPO и полная совместимость с HDR и OBS.";
                                    font-size: 11.5px;
                                    color: ThemeTokens.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Stage 2: Kernel & HID Input
                        Rectangle {
                            row: 0;
                            col: 1;
                            border-radius: 8px;
                            background: ThemeTokens.bg-elevated;
                            border-width: 1px;
                            border-color: ThemeTokens.border-subtle;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        IconCpu {
                                            size: 15px;
                                            color: ThemeTokens.accent-text;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Ядро и ввод HID";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: ThemeTokens.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "0x26 · HID 100";
                                        font-family: ThemeTokens.font-mono;
                                        font-size: 10.5px;
                                        font-weight: 500;
                                        color: ThemeTokens.accent-text;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Распарковка ядер ЦП, приоритет игры и стабильный буфер мыши до 8000 Гц.";
                                    font-size: 11.5px;
                                    color: ThemeTokens.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Stage 3: Memory & System Timer
                        Rectangle {
                            row: 1;
                            col: 0;
                            border-radius: 8px;
                            background: ThemeTokens.bg-elevated;
                            border-width: 1px;
                            border-color: ThemeTokens.border-subtle;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        IconMemory {
                                            size: 15px;
                                            color: ThemeTokens.accent-text;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Память и таймер";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: ThemeTokens.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "0.500 мс · Standby";
                                        font-family: ThemeTokens.font-mono;
                                        font-size: 10.5px;
                                        font-weight: 500;
                                        color: ThemeTokens.accent-text;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Точный системный таймер Windows и умная фоновая очистка кэша ОЗУ.";
                                    font-size: 11.5px;
                                    color: ThemeTokens.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Stage 4: Network & Zapret DPI Shield
                        Rectangle {
                            row: 1;
                            col: 1;
                            border-radius: 8px;
                            background: ThemeTokens.bg-elevated;
                            border-width: 1px;
                            border-color: ThemeTokens.border-subtle;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        IconShield {
                                            size: 15px;
                                            color: ThemeTokens.status-active-text;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Сеть и защита DPI";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: ThemeTokens.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: "MSI PCIe · Zapret";
                                        font-family: ThemeTokens.font-mono;
                                        font-size: 10.5px;
                                        font-weight: 500;
                                        color: ThemeTokens.status-active-text;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Низкая задержка TCP/AFD с защитой Zapret, WinDivert и RFC 1323 Timestamps.";
                                    font-size: 11.5px;
                                    color: ThemeTokens.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // 3. Hardware Telemetry & 0.500 ms System Timer Card
            SurfaceCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: "Оборудование и системный таймер";
                                font-size: 14.5px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: "Текущая телеметрия системы и управление точностью таймера Windows.";
                                font-size: 12px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Rectangle {
                                    height: 30px;
                                    border-radius: 15px;
                                    background: root.timer-locked ? ThemeTokens.status-active-soft : ThemeTokens.bg-elevated;
                                    border-width: 1px;
                                    border-color: root.timer-locked ? ThemeTokens.status-active-border : ThemeTokens.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: root.timer-locked ? ThemeTokens.status-active-text : ThemeTokens.text-muted;
                                            }
                                        }

                                        Text {
                                            text: root.timer-locked ? "0.500 мс" : "Штатный";
                                            font-family: root.timer-locked ? ThemeTokens.font-mono : ThemeTokens.font-sans;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: root.timer-locked ? ThemeTokens.status-active-text : ThemeTokens.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 30px;
                                    border-radius: 7px;
                                    background: root.timer-locked ? (tm-ta.pressed ? ThemeTokens.bg-active : (tm-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated)) : (tm-ta.pressed ? ThemeTokens.accent-solid-active : (tm-ta.has-hover ? ThemeTokens.accent-solid-hover : ThemeTokens.accent-solid));
                                    border-width: 1px;
                                    border-color: root.timer-locked ? (tm-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle) : ThemeTokens.accent-solid;


                                    tm-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: root.timer-locked ? "Переприменить 0.5 мс" : "Зафиксировать 0.5 мс";
                                        clicked => {
                                            root.toggle-timer-lock();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: root.timer-locked ? "Переприменить" : "Зафиксировать 0.5 мс";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: root.timer-locked ? ThemeTokens.text-primary : ThemeTokens.text-on-solid;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.timer-locked : Rectangle {
                                    height: 30px;
                                    border-radius: 7px;
                                    background: un-ta.pressed ? ThemeTokens.bg-active : (un-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                                    border-width: 1px;
                                    border-color: un-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;


                                    un-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: "Сбросить удержание системного таймера";
                                        clicked => {
                                            root.unlock-timer();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 11px;
                                        padding-right: 11px;
                                        Text {
                                            text: "Сбросить";
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: ThemeTokens.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 2x3 + 1 Hardware Telemetry Grid
                    GridLayout {
                        spacing: 10px;

                        TelemetryTile {
                            row: 0;
                            col: 0;
                            label: "Процессор";
                            value: root.cpu-name;
                        }

                        TelemetryTile {
                            row: 0;
                            col: 1;
                            label: "Видеоадаптер";
                            value: root.gpu-name;
                        }

                        TelemetryTile {
                            row: 1;
                            col: 0;
                            label: "Оперативная память";
                            value: root.ram-summary;
                        }

                        TelemetryTile {
                            row: 1;
                            col: 1;
                            label: "Дисплей и композитор DWM";
                            value: root.display-summary;
                        }

                        TelemetryTile {
                            row: 2;
                            col: 0;
                            label: "Планировщик ядра и DPC";
                            value: root.dpc-latency;
                        }

                        TelemetryTile {
                            row: 2;
                            col: 1;
                            label: "Мультиплейн-оверлеи (MPO)";
                            value: root.mpo-status;
                        }

                        TelemetryTile {
                            row: 3;
                            col: 0;
                            colspan: 2;
                            label: "Разрешение системного таймера Windows";
                            value: root.timer-resolution;
                            monospace-value: true;
                            accent-value: root.timer-locked;
                        }
                    }
                }
            }

            // 4. GitHub Releases Updates Card
            SurfaceCard {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Обновления приложения";
                                font-size: 14px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 20px;
                                    border-radius: 5px;
                                    background: ThemeTokens.accent-soft;
                                    border-width: 1px;
                                    border-color: ThemeTokens.accent-border;

                                    HorizontalLayout {
                                        padding-left: 7px;
                                        padding-right: 7px;
                                        Text {
                                            text: "v" + root.app-version;
                                            font-family: ThemeTokens.font-mono;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            color: ThemeTokens.accent-text;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.update-status-text;
                            font-size: 12px;
                            color: root.update-is-error ? ThemeTokens.status-warn-text : (root.has-update ? ThemeTokens.accent-text : ThemeTokens.status-active-text);
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            if root.has-update || root.is-installing-update : Rectangle {
                                height: 32px;
                                border-radius: 7px;
                                background: (root.is-installing-update || root.is-checking-updates || root.is-busy) ? ThemeTokens.bg-elevated : (inst-ta.pressed ? ThemeTokens.accent-solid-active : (inst-ta.has-hover ? ThemeTokens.accent-solid-hover : ThemeTokens.accent-solid));
                                border-width: 1px;
                                border-color: inst-fs.has-focus ? ThemeTokens.focus-ring : ((root.is-installing-update || root.is-checking-updates || root.is-busy) ? ThemeTokens.border-subtle : ThemeTokens.accent-solid);

                                inst-fs := FocusScope {
                                    enabled: !root.is-installing-update && !root.is-checking-updates && !root.is-busy;
                                    key-pressed(event) => {
                                        if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                                            root.install-update();
                                            return accept;
                                        }
                                        return reject;
                                    }

                                    inst-ta := TouchArea {
                                        enabled: !root.is-installing-update && !root.is-checking-updates && !root.is-busy;
                                        mouse-cursor: (!root.is-installing-update && !root.is-checking-updates && !root.is-busy) ? pointer : default;
                                        accessible-role: button;
                                        accessible-label: root.is-installing-update ? "Установка обновления" : ("Установить обновление v" + root.latest-version);
                                        clicked => {
                                            inst-fs.focus();
                                            root.install-update();
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.is-installing-update ? "Установка…" : ("Установить v" + root.latest-version);
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: (root.is-installing-update || root.is-checking-updates || root.is-busy) ? ThemeTokens.text-muted : ThemeTokens.text-on-solid;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: 7px;
                                opacity: (root.is-checking-updates || root.is-installing-update) ? 0.6 : 1.0;
                                background: upd-ta.pressed ? ThemeTokens.bg-active : (upd-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                                border-width: 1px;
                                border-color: upd-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;

                                upd-ta := TouchArea {
                                    enabled: !root.is-checking-updates && !root.is-installing-update;
                                    mouse-cursor: (!root.is-checking-updates && !root.is-installing-update) ? pointer : default;
                                    accessible-role: button;
                                    accessible-label: "Проверить обновления";
                                    clicked => {
                                        root.check-updates();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.is-checking-updates ? "Проверка…" : (root.has-update ? "Проверить" : "Проверить обновления");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: (root.is-checking-updates || root.is-installing-update) ? ThemeTokens.text-muted : ThemeTokens.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: 7px;
                                opacity: root.is-installing-update ? 0.6 : 1.0;
                                background: rel-ta.pressed ? ThemeTokens.bg-active : (rel-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                                border-width: 1px;
                                border-color: rel-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle;

                                rel-ta := TouchArea {
                                    enabled: !root.is-installing-update;
                                    mouse-cursor: !root.is-installing-update ? pointer : default;
                                    accessible-role: button;
                                    accessible-label: "Открыть страницу GitHub Releases";
                                    clicked => {
                                        root.open-releases-page();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: "GitHub Releases";
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: ThemeTokens.text-secondary;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        IconExternal {
                                            size: 12px;
                                            color: ThemeTokens.text-muted;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
