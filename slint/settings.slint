import { ThemeTokens, ThemeCardItem } from "theme.slint";
import { SurfaceCard, ThemedScrollView, ThemedSwitch, IconCheck } from "components.slint";

component ThemePreviewCard inherits Rectangle {
    in property <ThemeCardItem> card;
    callback clicked-theme(string);

    height: 114px;
    border-radius: 10px;
    background: ta.pressed ? ThemeTokens.bg-active : (ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
    border-width: (card.is-active || fs.has-focus) ? 2px : 1px;
    border-color: fs.has-focus ? ThemeTokens.focus-ring : (card.is-active ? ThemeTokens.accent-solid : (ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle));
    drop-shadow-offset-y: ta.has-hover ? ThemeTokens.shadow-card-hover-offset-y : 0px;
    drop-shadow-blur: ta.has-hover ? ThemeTokens.shadow-card-hover-blur : 0px;
    drop-shadow-color: ta.has-hover ? ThemeTokens.shadow-card-hover-color : transparent;


    // Subtle accent tint layered properly over bg-elevated when active
    if card.is-active : Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 8px;
        background: ThemeTokens.accent-card-tint;
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked-theme(root.card.id);
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.card.name-ru;
            clicked => {
                fs.focus();
                root.clicked-theme(root.card.id);
            }
        }
    }

    VerticalLayout {
        padding: 9px;
        spacing: 8px;

        // Mini-Preview Window Canvas (exact preview-* tokens)
        Rectangle {
            height: 56px;
            border-radius: 6px;
            background: card.preview-bg;
            border-width: 1px;
            border-color: card.preview-border;
            clip: true;

            VerticalLayout {
                padding: 7px;
                spacing: 6px;

                // Mini Header Bar
                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;

                    Rectangle {
                        width: 10px;
                        height: 8px;
                        border-radius: 2.5px;
                        background: card.preview-accent;
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: card.preview-text.with-alpha(0.75);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 16px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: card.preview-accent-text;
                        }
                    }
                }

                // Mini Surface & Elevated Cards
                HorizontalLayout {
                    spacing: 5px;

                    Rectangle {
                        horizontal-stretch: 2;
                        height: 26px;
                        border-radius: 4px;
                        background: card.preview-surface;
                        border-width: 1px;
                        border-color: card.preview-border;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 5px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 12px;
                                    height: 10px;
                                    border-radius: 3px;
                                    background: card.preview-accent;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;

                                Rectangle {
                                    width: 85%;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: card.preview-text.with-alpha(0.8);
                                }
                                Rectangle {
                                    width: 55%;
                                    height: 3.5px;
                                    border-radius: 1.75px;
                                    background: card.preview-text.with-alpha(0.35);
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        border-radius: 4px;
                        background: card.preview-elevated;
                        border-width: 1px;
                        border-color: card.preview-border;
                    }
                }
            }

            // Compact active checkmark emblem in top-right corner of preview
            if card.is-active : Rectangle {
                x: parent.width - 22px;
                y: 4px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: ThemeTokens.accent-solid;

                IconCheck {
                    x: 3.5px;
                    y: 3.5px;
                    size: 11px;
                    stroke-width: 2.6px;
                    color: ThemeTokens.text-on-solid;
                }
            }
        }

        // Theme Title + Polarity
        VerticalLayout {
            spacing: 1px;

            Text {
                text: card.name-ru;
                font-size: 12px;
                font-weight: 600;
                color: card.is-active ? ThemeTokens.accent-text : ThemeTokens.text-primary;
                overflow: elide;
            }

            Text {
                text: card.is-dark ? "Тёмная тема" : "Светлая тема";
                font-size: 10.5px;
                color: ThemeTokens.text-muted;
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    in property <ThemeCardItem> theme-card-0;
    in property <ThemeCardItem> theme-card-1;
    in property <ThemeCardItem> theme-card-2;
    in property <ThemeCardItem> theme-card-3;
    in property <ThemeCardItem> theme-card-4;
    in property <ThemeCardItem> theme-card-5;
    in property <ThemeCardItem> theme-card-6;
    in property <ThemeCardItem> theme-card-7;

    in property <bool> autostart-enabled: false;
    in property <bool> autostart-start-in-tray: true;
    in property <bool> autostart-path-mismatch: false;
    in property <string> autostart-warning: "";

    in property <bool> auto-lock-timer-in-gaming: true;
    in property <bool> auto-purge-ram-in-gaming: true;
    in property <int> auto-purge-ram-threshold-mb: 2048;

    callback select-theme(string);
    callback toggle-autostart(bool, bool);
    callback toggle-auto-lock-timer();
    callback toggle-auto-purge-ram();
    callback set-ram-threshold(int);

    background: transparent;

    ThemedScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // 1. 4x2 Theme Selector Grid Card
            SurfaceCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: "Тема оформления";
                                font-size: 14.5px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: "Мгновенная смена палитры и рамки Windows. Тумблер в шапке переключает тёмную и светлую темы.";
                                font-size: 12px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                border-radius: 13px;
                                background: ThemeTokens.accent-soft;
                                border-width: 1px;
                                border-color: ThemeTokens.accent-border;

                                HorizontalLayout {
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    Text {
                                        text: ThemeTokens.active-theme-name;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: ThemeTokens.accent-text;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 4x2 Theme GridLayout
                    GridLayout {
                        spacing: 10px;

                        ThemePreviewCard {
                            row: 0;
                            col: 0;
                            card: root.theme-card-0;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 0;
                            col: 1;
                            card: root.theme-card-1;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 0;
                            col: 2;
                            card: root.theme-card-2;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 0;
                            col: 3;
                            card: root.theme-card-3;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 1;
                            col: 0;
                            card: root.theme-card-4;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 1;
                            col: 1;
                            card: root.theme-card-5;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 1;
                            col: 2;
                            card: root.theme-card-6;
                            clicked-theme(id) => { root.select-theme(id); }
                        }

                        ThemePreviewCard {
                            row: 1;
                            col: 3;
                            card: root.theme-card-7;
                            clicked-theme(id) => { root.select-theme(id); }
                        }
                    }
                }
            }

            // 2. Autostart & Background Mode Card
            SurfaceCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 14px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: "Запуск вместе с Windows";
                                font-size: 14px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: "Регистрирует задачу Планировщика Windows с повышенными правами без лишних запросов UAC при входе в систему.";
                                font-size: 12px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            ThemedSwitch {
                                checked: root.autostart-enabled;
                                accessible-name: "Запускать вместе с Windows";
                                toggled => {
                                    root.toggle-autostart(!root.autostart-enabled, root.autostart-start-in-tray);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "При входе в систему:";
                            font-size: 12px;
                            color: ThemeTokens.text-muted;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: root.autostart-start-in-tray ? ThemeTokens.accent-soft : (tray-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: 1px;
                            border-color: root.autostart-start-in-tray ? ThemeTokens.accent-border : (tray-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle);


                            tray-ta := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "При входе запускать сразу в трей";
                                clicked => {
                                    root.toggle-autostart(root.autostart-enabled, true);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Сразу в трей";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: root.autostart-start-in-tray ? ThemeTokens.accent-text : ThemeTokens.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: !root.autostart-start-in-tray ? ThemeTokens.accent-soft : (win-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: 1px;
                            border-color: !root.autostart-start-in-tray ? ThemeTokens.accent-border : (win-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle);


                            win-ta := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "При входе открывать окно";
                                clicked => {
                                    root.toggle-autostart(root.autostart-enabled, false);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Открывать окно";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: !root.autostart-start-in-tray ? ThemeTokens.accent-text : ThemeTokens.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.autostart-path-mismatch : Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: fix-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.status-warn-soft;
                            border-width: 1px;
                            border-color: ThemeTokens.status-warn-border;

                            fix-ta := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "Исправить путь задачи автозапуска";
                                clicked => {
                                    root.toggle-autostart(true, root.autostart-start-in-tray);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Исправить путь";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: ThemeTokens.status-warn-text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.autostart-warning != "" : Text {
                        text: root.autostart-warning;
                        font-size: 11.5px;
                        color: ThemeTokens.status-warn-text;
                        wrap: word-wrap;
                    }
                }
            }

            // 3. AAA Background Automation (0.500ms Timer + Standby RAM Auto-Purge)
            SurfaceCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    Text {
                        text: "Фоновая автоматика AAA";
                        font-size: 14.5px;
                        font-weight: 600;
                        color: ThemeTokens.text-primary;
                    }

                    // AutoLockTimerInGaming
                    HorizontalLayout {
                        spacing: 14px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: "Автофиксация системного таймера 0.500 мс";
                                font-size: 13px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: "В активном игровом режиме автоматически удерживает системный таймер NtSetTimerResolution(0.500 мс) и снимает фиксацию при возврате в штатный режим.";
                                font-size: 12px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            ThemedSwitch {
                                checked: root.auto-lock-timer-in-gaming;
                                accessible-name: "Автоматически фиксировать таймер 0.500 мс";
                                toggled => {
                                    root.toggle-auto-lock-timer();
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: ThemeTokens.border-subtle;
                    }

                    // AutoPurgeRamInGaming
                    HorizontalLayout {
                        spacing: 14px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: "Умная фоновая автоочистка Standby-кэша ОЗУ";
                                font-size: 13px;
                                font-weight: 600;
                                color: ThemeTokens.text-primary;
                            }

                            Text {
                                text: "Каждые 60 секунд в активном игровом режиме проверяет свободную ОЗУ и очищает Standby List, если доступно меньше порога (пауза — 180 сек).";
                                font-size: 12px;
                                color: ThemeTokens.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            ThemedSwitch {
                                checked: root.auto-purge-ram-in-gaming;
                                accessible-name: "Умная фоновая автоочистка Standby-кэша ОЗУ";
                                toggled => {
                                    root.toggle-auto-purge-ram();
                                }
                            }
                        }
                    }

                    // RAM Threshold Selector
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Порог свободной ОЗУ:";
                            font-size: 12px;
                            color: ThemeTokens.text-muted;
                            vertical-alignment: center;
                        }

                        for thresh in [
                            { val: 1024, label: "1 ГБ" },
                            { val: 2048, label: "2 ГБ" },
                            { val: 3072, label: "3 ГБ" },
                            { val: 4096, label: "4 ГБ" },
                        ] : Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            opacity: root.auto-purge-ram-in-gaming ? 1.0 : 0.45;
                            background: root.auto-purge-ram-threshold-mb == thresh.val ? ThemeTokens.accent-soft : (th-ta.has-hover ? ThemeTokens.bg-hover : ThemeTokens.bg-elevated);
                            border-width: 1px;
                            border-color: root.auto-purge-ram-threshold-mb == thresh.val ? ThemeTokens.accent-border : (th-ta.has-hover ? ThemeTokens.border-strong : ThemeTokens.border-subtle);


                            th-ta := TouchArea {
                                enabled: root.auto-purge-ram-in-gaming;
                                mouse-cursor: root.auto-purge-ram-in-gaming ? pointer : default;
                                accessible-role: button;
                                accessible-label: "Порог свободной ОЗУ " + thresh.label;
                                clicked => {
                                    root.set-ram-threshold(thresh.val);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: thresh.label;
                                    font-family: ThemeTokens.font-mono;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: root.auto-purge-ram-threshold-mb == thresh.val ? ThemeTokens.accent-text : ThemeTokens.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
