<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?ifndef AppVersion ?>
    <?define AppVersion = "4.1.1.0" ?>
  <?endif?>

  <Product
    Id="*"
    Name="Ultra Gaming Mode"
    Language="1033"
    Version="$(var.AppVersion)"
    Manufacturer="Ultra Gaming Mode Team"
    UpgradeCode="7630b84c-95f6-58d0-8c30-969d061c38b0">

    <Package
      InstallerVersion="450"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="Ultra Gaming Mode v4.1.1 Native Windows 11 Gaming Optimizer"
      Manufacturer="Ultra Gaming Mode Team" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Ultra Gaming Mode is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="NSIS_UNINSTALL_STRING">
      <RegistrySearch
        Id="FindNsisInstall"
        Root="HKLM"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\UltraGamingMode"
        Name="UninstallString"
        Type="raw"
        Win64="yes" />
    </Property>

    <Condition Message="Ultra Gaming Mode is already installed via the Setup (.exe) installer. Please uninstall the existing Setup version first or use UltraGamingMode-Setup.exe to upgrade.">
      Installed OR NOT NSIS_UNINSTALL_STRING
    </Condition>

    <util:CloseApplication
      Id="CloseUltraGamingMode"
      Target="UltraGamingMode.exe"
      CloseMessage="yes"
      ElevatedCloseMessage="yes"
      ElevatedEndSessionMessage="yes"
      RebootPrompt="no"
      TerminateProcess="0"
      Timeout="2" />

    <util:CloseApplication
      Id="CloseLegacyUltraGamingMode"
      Target="ultra-gaming-mode.exe"
      CloseMessage="yes"
      ElevatedCloseMessage="yes"
      ElevatedEndSessionMessage="yes"
      RebootPrompt="no"
      TerminateProcess="0"
      Timeout="1" />

    <CustomAction
      Id="SetStopRunningAppDeferred"
      Property="StopRunningAppDeferred"
      Value="&quot;[System64Folder]cmd.exe&quot; /c taskkill.exe /F /T /IM UltraGamingMode.exe &gt;nul 2&gt;&amp;1 &amp; taskkill.exe /F /T /IM ultra-gaming-mode.exe &gt;nul 2&gt;&amp;1 &amp; exit /b 0" />
    <CustomAction
      Id="StopRunningAppDeferred"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec64"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <CustomAction
      Id="SetCleanupScheduledTasksDeferred"
      Property="CleanupScheduledTasksDeferred"
      Value="&quot;[System64Folder]cmd.exe&quot; /c schtasks.exe /Delete /TN &quot;UltraGamingMode_AutoStart&quot; /F &gt;nul 2&gt;&amp;1 &amp; schtasks.exe /Delete /TN &quot;UltraGamingMode_BootTrigger&quot; /F &gt;nul 2&gt;&amp;1 &amp; schtasks.exe /Delete /TN &quot;UltraGamingMode_Watchdog&quot; /F &gt;nul 2&gt;&amp;1 &amp; exit /b 0" />
    <CustomAction
      Id="CleanupScheduledTasksDeferred"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec64"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetStopRunningAppDeferred" Before="RemoveFiles" />
      <Custom Action="StopRunningAppDeferred" After="SetStopRunningAppDeferred" />
      <Custom Action="SetCleanupScheduledTasksDeferred" After="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CleanupScheduledTasksDeferred" After="SetCleanupScheduledTasksDeferred">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <Icon Id="AppIcon.ico" SourceFile="..\assets\icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/RagTagsky/Win11-Gaming-Optimizer" />

    <UIRef Id="WixUI_Minimal" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="UltraGamingMode">
          <Directory Id="CoreFolder" Name="Core" />
          <Directory Id="ConfigFolder" Name="Config" />
          <Directory Id="TestsFolder" Name="Tests" />
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Ultra Gaming Mode" />
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C01" Win64="yes">
        <File Id="UltraGamingModeExe" Name="UltraGamingMode.exe" Source="..\.bin\UltraGamingMode.exe" KeyPath="yes" />
      </Component>
      <Component Id="RootScripts" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C02" Win64="yes">
        <File Id="UltraGamingModePs1" Name="UltraGamingMode.ps1" Source="..\UltraGamingMode.ps1" KeyPath="yes" />
        <File Id="UltraGamingModeBat" Name="UltraGamingMode.bat" Source="..\UltraGamingMode.bat" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="CoreFolder">
      <Component Id="CoreScripts" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C03" Win64="yes">
        <File Id="ServiceManagerPs1" Name="ServiceManager.ps1" Source="..\Core\ServiceManager.ps1" KeyPath="yes" />
        <File Id="StateEnginePs1" Name="StateEngine.ps1" Source="..\Core\StateEngine.ps1" />
        <File Id="SystemOptimizerPs1" Name="SystemOptimizer.ps1" Source="..\Core\SystemOptimizer.ps1" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="TestsFolder">
      <Component Id="VerifyScript" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C04" Win64="yes">
        <File Id="VerifyUniversalEnginePs1" Name="Verify-UniversalEngine.ps1" Source="..\Tests\Verify-UniversalEngine.ps1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ConfigFolder">
      <Component Id="ConfigFiles" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C05" Win64="yes">
        <File Id="ServiceDescriptionsJson" Name="service_descriptions.json" Source="..\Config\service_descriptions.json" KeyPath="yes" />
        <File Id="ProcessDescriptionsJson" Name="process_descriptions.json" Source="..\Config\process_descriptions.json" />
        <File Id="ServicesBlacklistJson" Name="services_blacklist.json" Source="..\Config\services_blacklist.json" />
        <File Id="ServicesWhitelistJson" Name="services_whitelist.json" Source="..\Config\services_whitelist.json" />
        <File Id="StartupAppsJson" Name="startup_apps.json" Source="..\Config\startup_apps.json" />
        <File Id="TuningJson" Name="tuning.json" Source="..\Config\tuning.json" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C06" Win64="yes">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="Ultra Gaming Mode"
          Description="Ultra Gaming Mode - Windows 11 AAA Gaming Optimizer"
          Target="[INSTALLFOLDER]UltraGamingMode.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico"
          IconIndex="0" />
        <RemoveFile Id="RemoveLegacyRootStartMenuShortcut" Directory="ProgramMenuFolder" Name="UltraGamingMode.lnk" On="both" />
        <RemoveFile Id="RemoveLegacyNsisUninstallShortcut" Name="Uninstall Ultra Gaming Mode.lnk" On="both" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\UltraGamingMode" Name="StartMenuShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="B85B40A4-9B1F-49F2-A2A4-5F31E18E7C07" Win64="yes">
        <Shortcut
          Id="ApplicationDesktopShortcut"
          Name="Ultra Gaming Mode"
          Description="Ultra Gaming Mode - Windows 11 AAA Gaming Optimizer"
          Target="[INSTALLFOLDER]UltraGamingMode.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico"
          IconIndex="0" />
        <RemoveFile Id="RemoveLegacyDesktopShortcut" Name="UltraGamingMode.lnk" On="both" />
        <RegistryValue Root="HKCU" Key="Software\UltraGamingMode" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="Ultra Gaming Mode" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="RootScripts" />
      <ComponentRef Id="CoreScripts" />
      <ComponentRef Id="VerifyScript" />
      <ComponentRef Id="ConfigFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
